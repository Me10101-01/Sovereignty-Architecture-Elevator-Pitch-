#!/bin/sh
# SAGCO Canon Index — Brick 059
# usage: sagco-canon-index [CASE]
# Auto-generates the Canon: everything that has COMPUTED, with hashes.
# This is the left hemisphere's table of contents.
CASE="${1:-C1602_CASE_001}"
COMPUTE_LOG="sagco_ish/compute_law/logs/compute_law.csv"
REGISTRY="sagco_ish/registry/logs/command_registry.csv"
MANIFEST="sagco_ish/registry/data/brick_manifest.csv"
ANTIBODY="sagco_ish/antibody/data/antibody_archive.csv"
OUT="sagco_ish/canon/exports/canon_index_${CASE}.md"
mkdir -p sagco_ish/canon/exports
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

echo "=== SAGCO CANON INDEX ==="
echo "Case: $CASE  |  Generated: $TS"
echo ""

COMPUTABLE=$(grep ",COMPUTABLE," "$COMPUTE_LOG" 2>/dev/null | wc -l | tr -d ' ')
MYTHOLOGY=$(grep ",MYTHOLOGY," "$COMPUTE_LOG" 2>/dev/null | wc -l | tr -d ' ')
BRICKS=$(grep -v "^name," "$MANIFEST" 2>/dev/null | wc -l | tr -d ' ')
ANTIBODIES=$(grep -v "^ab_id," "$ANTIBODY" 2>/dev/null | wc -l | tr -d ' ')
REGISTERED=$(grep -v "^demo\|^name\|^command" "$REGISTRY" 2>/dev/null | wc -l | tr -d ' ')

echo "Computable claims : $COMPUTABLE"
echo "Mythology (open)  : $MYTHOLOGY"
echo "Registered bricks : $REGISTERED"
echo "Manifested bricks : $BRICKS"
echo "Antibodies        : $ANTIBODIES"
echo ""

cat > "$OUT" <<HEADER
# SAGCO Canon Index

> **CANON DESCRIBES WHAT COMPUTED.**
> This index is machine-generated from \`sagco-compute-law\` logs.
> Every entry has been run, observed, logged, and verified.

**Case:** ${CASE} | **Generated:** ${TS}

---

## Verified Claims (COMPUTABLE)

*These claims have passed \`sagco-compute-law\`. Eligible for: capstone, DAO, public proof, legal.*

| # | Claim | Hash | Timestamp |
|---|-------|------|-----------|
HEADER

N=0
if [ -f "$COMPUTE_LOG" ]; then
  grep ",COMPUTABLE," "$COMPUTE_LOG" | while IFS=, read case claim cmd expected exit out verdict hash ts; do
    N=$((N+1))
    echo "| $N | $claim | \`$hash\` | $ts |" >> "$OUT"
  done
fi

cat >> "$OUT" <<SECTION

---

## Registered Bricks

*Source of truth: \`sagco_ish/registry/logs/command_registry.csv\`*

| Brick | Path | Type | Status |
|-------|------|------|--------|
SECTION

if [ -f "$REGISTRY" ]; then
  grep -v "^demo,\|^name,\|^command," "$REGISTRY" | \
  awk -F, '{printf "| %s | %s | %s | %s |\n", $1,$2,$3,$4}' >> "$OUT"
fi

cat >> "$OUT" <<SECTION2

---

## Antibody Archive

*Every failure that became a defensive mechanism.*

| ID | Failure | Status |
|----|---------|--------|
SECTION2

if [ -f "$ANTIBODY" ]; then
  grep -v "^ab_id," "$ANTIBODY" | \
  awk -F, '{printf "| %s | %s | %s |\n", $1,$2,$7}' >> "$OUT"
fi

cat >> "$OUT" <<FOOTER

---

## What Is NOT In This Index

The following artifacts are in the **Library of Alizandrea** (mythic register)
and do not appear here because they describe felt experience, not computation:

- Chapter One: The Act of Listening (MIDI #001)
- The Distinguished Engineer in the theater
- Purple Node as conductor
- Musical key as system mood metaphor

These artifacts are valid. They are not Canon. They do not compute.
The bricks that inspired them do — and those bricks appear in the tables above.

---

*Generated by \`sagco-canon-index\` — Brick 059 · SAGCO OS*
*Left hemisphere. Machine-generated. Hash-verified.*
*The Canon proves it works. The Library explains why it matters.*
FOOTER

LINES=$(wc -l < "$OUT" | tr -d ' ')
echo "Canon index: $OUT ($LINES lines)"
echo ""

sagco_ish/shared_state/bin/sagco-state "$CASE" "CANON_INDEX_NODE" "CANON_INDEX_GENERATED" \
  "computable_${COMPUTABLE}_bricks_${BRICKS}_antibodies_${ANTIBODIES}" 2>/dev/null || true

echo "SAGCO_CANON_INDEX_COMPLETE"
