#!/bin/sh
CASE="$1"
OUT="${2:-sagco_ish/portfolio/case-studies/${CASE}_SAGCO_Portfolio_Case_Study.md}"
[ -z "$CASE" ] && echo "usage: sagco-portfolio-generate CASE" && exit 1
mkdir -p "$(dirname "$OUT")"
STATE="sagco_ish/shared_state/cases/${CASE}.json"
FUZZ="sagco_ish/portfolio/logs/portfolio_fuzz.csv"
EVID="sagco_ish/evidence/logs/evidence_register.csv"
ERU="sagco_ish/wafer/logs/wafer_eru.csv"
cat > "$OUT" <<DOC
# SAGCO Portfolio Case Study: $CASE
## Executive Summary
SAGCO is a lightweight, multi-node field software system running on iSH / mobile devices.
This case study documents a live workflow using shared state, evidence hashing, fuzz scanning, ERU variance tracking, and portfolio signal extraction.
## System Architecture
- Shared state mesh
- Gmail / PDF ingest
- Evidence registry
- ERU expected-vs-actual variance
- Portfolio GIDRA fuzz scanner
- Dashboard loop
## Current Case State
\`\`\`json
$(cat "$STATE" 2>/dev/null || echo "STATE_NOT_FOUND")
\`\`\`
## Portfolio Signals
\`\`\`csv
$(tail -n 25 "$FUZZ" 2>/dev/null || echo "NO_PORTFOLIO_FUZZ_LOG")
\`\`\`
## Evidence Registry
\`\`\`csv
$(tail -n 15 "$EVID" 2>/dev/null || echo "NO_EVIDENCE_LOG")
\`\`\`
## ERU / Wafer Variance
\`\`\`csv
$(tail -n 15 "$ERU" 2>/dev/null || echo "NO_ERU_LOG")
\`\`\`
## Software Engineering Value
This project demonstrates:
- Automation
- Logging
- Command registry design
- Evidence chain-of-custody
- Multi-agent orchestration
- Field-data capture
- Expected vs actual validation
## Status
SAGCO_PORTFOLIO_CASE_STUDY_GENERATED
DOC
echo "SAGCO_PORTFOLIO_GENERATED"
echo "$OUT"
