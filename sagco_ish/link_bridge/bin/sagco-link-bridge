#!/bin/sh
# SAGCO Link Bridge — Brick 057
# usage: sagco-link-bridge URL [LAN_IP] [OUTPUT_NAME] [CASE]
# Turns localhost links into cross-device LAN links and logs the evidence
URL="$1"
LAN_IP="${2:-auto}"
OUTNAME="${3:-evidence_link}"
CASE="${4:-C1602_CASE_001}"

[ -z "$URL" ] && echo "usage: sagco-link-bridge URL [LAN_IP] [OUTPUT_NAME] [CASE]" && exit 1

OUT="sagco_ish/link_bridge/logs/link_bridge.csv"
REPORT="sagco_ish/link_bridge/logs/link_bridge_report.txt"
mkdir -p sagco_ish/link_bridge/logs

[ ! -f "$OUT" ] && echo "timestamp,case,original_url,lan_ip,replaced_url,output_name,status" > "$OUT"

TS=$(busybox date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

# Auto-detect LAN IP — tries multiple methods in order
if [ "$LAN_IP" = "auto" ]; then
  # ip route (Linux/Alpine/iSH)
  LAN_IP=$(ip route get 1 2>/dev/null | awk '{print $7; exit}')
  # fallback: hostname -I (most Linux)
  [ -z "$LAN_IP" ] && LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  # fallback: ifconfig grep (BSD/macOS/iSH)
  [ -z "$LAN_IP" ] && LAN_IP=$(ifconfig 2>/dev/null | grep 'inet ' | grep -v '127.0.0.1' | awk '{print $2}' | head -1)
  # sentinel if nothing works
  [ -z "$LAN_IP" ] && LAN_IP="192.168.1.XXX"
fi

# Extract port from original URL
PORT=$(echo "$URL" | grep -o ':[0-9]*$' | tr -d ':')
[ -z "$PORT" ] && PORT=$(echo "$URL" | grep -oE ':[0-9]+/' | tr -d ':/' | head -1)

# Replace all localhost variants
REPLACED_URL=$(echo "$URL" | sed "s|localhost|${LAN_IP}|g" | sed "s|127\.0\.0\.1|${LAN_IP}|g")

# Detect protocol and context
PROTO=$(echo "$URL" | grep -o '^[a-z]*://' | tr -d '://')
[ -z "$PROTO" ] && PROTO="http"

# Device-specific instructions
WC_URL=$(echo "$REPLACED_URL" | sed 's|http://||' | sed 's|https://||')

echo "SAGCO_LINK_BRIDGED"
echo "Case    : $CASE"
echo "Original: $URL"
echo "LAN IP  : $LAN_IP"
echo "Replaced: $REPLACED_URL"
echo ""
echo "--- CROSS-DEVICE INSTRUCTIONS ---"
echo "1. iPad/Android (same WiFi)  : Open $REPLACED_URL"
echo "2. Working Copy              : Pull repo then browse $REPLACED_URL"
echo "3. Dropbox export            : sagco_ish/public/site/ → share folder"
echo "4. QR code (optional)        : qrencode -t ANSI '$REPLACED_URL'"
echo "5. iSH direct                : if same machine, use localhost"
echo ""

# Log evidence
echo "$TS,$CASE,$URL,$LAN_IP,$REPLACED_URL,$OUTNAME,BRIDGED" >> "$OUT"

# Write portable report
cat > "$REPORT" <<RPT
# SAGCO Link Bridge Report
**Case:** $CASE | **Generated:** $TS

## Link Translation

| Field | Value |
|-------|-------|
| Original URL | $URL |
| LAN IP | $LAN_IP |
| Replaced URL | **$REPLACED_URL** |
| Port | ${PORT:-80} |
| Output Name | $OUTNAME |

## Cross-Device Instructions

1. **iPad/Android** (same WiFi): Open [$REPLACED_URL]($REPLACED_URL)
2. **Working Copy**: Pull repo, then browse to $REPLACED_URL
3. **Dropbox**: Export \`sagco_ish/public/site/\` folder as evidence
4. **QR code**: \`qrencode -t ANSI '$REPLACED_URL'\`

## COMMANDMENT

> NO LOCALHOST CLAIMS UNTIL LAN DEVICE OPENS IT

*Generated by \`sagco-link-bridge\` — Brick 057*
RPT

sagco_ish/shared_state/bin/sagco-state "$CASE" "LINK_BRIDGE_NODE" "BRIDGED" \
  "lan_${LAN_IP}_port_${PORT:-80}_output_${OUTNAME}" 2>/dev/null || true

echo "EVIDENCE: $OUT"
echo "REPORT  : $REPORT"
