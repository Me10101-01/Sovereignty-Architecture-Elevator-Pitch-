#!/bin/sh
# sagco-state-read: query shared mesh state for a case
# Usage: sagco-state-read <CASE_ID>
CASE="$1"
if [ -z "$CASE" ]; then
    echo "Usage: sagco-state-read <CASE_ID>"
    exit 1
fi
CASEFILE="sagco_ish/shared_state/cases/${CASE}.json"
LOG="sagco_ish/shared_state/logs/state_updates.csv"
if [ ! -f "$CASEFILE" ]; then
    echo "STATE_NOT_FOUND: no state for $CASE"
    echo "Run: sagco-state $CASE <NODE> <STATUS> <NOTE>"
    exit 1
fi
echo "SAGCO_STATE_READ"
echo "CASE=$CASE"
echo "---"
cat "$CASEFILE"
echo "---"
echo "HISTORY:"
if [ -f "$LOG" ]; then
    grep "^$CASE," "$LOG" | tail -10
else
    echo "NO_HISTORY"
fi
