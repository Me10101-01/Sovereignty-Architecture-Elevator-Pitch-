#!/bin/sh
CASE="$1"
STATEFILE="sagco_ish/shared_state/cases/${CASE}.json"
LOGFILE="sagco_ish/shared_state/logs/state_updates.csv"
if [ -z "$CASE" ]; then
  echo "usage: sagco-state-read CASE"
  exit 1
fi
if [ ! -f "$STATEFILE" ]; then
  echo "STATE_NOT_FOUND: $CASE"
  exit 1
fi
echo "=== SAGCO STATE: $CASE ==="
cat "$STATEFILE"
echo ""
echo "=== RECENT HISTORY ==="
grep "^$CASE," "$LOGFILE" 2>/dev/null | tail -n 5
echo ""
echo "SAGCO_STATE_READER_COMPLETE"
