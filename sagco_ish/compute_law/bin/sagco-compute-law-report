#!/bin/sh
# SAGCO Compute Law Report — Brick 058b
# usage: sagco-compute-law-report [CASE]
# Exports a Compute Law audit report: which claims are COMPUTABLE vs MYTHOLOGY
CASE="${1:-C1602_CASE_001}"
LOG="sagco_ish/compute_law/logs/compute_law.csv"
REPORT="sagco_ish/compute_law/reports/compute_law_report_${CASE}.md"
mkdir -p sagco_ish/compute_law/reports
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

[ ! -f "$LOG" ] && echo "NO_LOG: run sagco-compute-law first" && exit 1

echo "=== SAGCO COMPUTE LAW REPORT ==="
echo "Case: $CASE  |  Generated: $TS"
echo ""

TOTAL=$(grep -v "^case," "$LOG" | wc -l | tr -d ' ')
COMPUTABLE=$(grep ",COMPUTABLE," "$LOG" | wc -l | tr -d ' ')
PARTIAL=$(grep ",PARTIAL," "$LOG" | wc -l | tr -d ' ')
MYTHOLOGY=$(grep ",MYTHOLOGY," "$LOG" | wc -l | tr -d ' ')

echo "Total claims : $TOTAL"
echo "COMPUTABLE   : $COMPUTABLE"
echo "PARTIAL      : $PARTIAL"
echo "MYTHOLOGY    : $MYTHOLOGY"
echo ""

SCORE=$(awk "BEGIN { if ($TOTAL==0) print 0; else printf \"%.1f\", ($COMPUTABLE/$TOTAL)*100 }")
echo "TRUTH SCORE  : ${SCORE}%"

VERDICT="COMPUTE_LAW_ACTIVE"
awk "BEGIN {exit !($SCORE >= 90)}" && VERDICT="COMPUTE_LAW_EXEMPLARY"
awk "BEGIN {exit !($SCORE < 70)}"  && VERDICT="COMPUTE_LAW_REVIEW_REQUIRED"
echo "VERDICT      : $VERDICT"
echo ""

cat > "$REPORT" <<MD
# SAGCO Compute Law Report

**Case:** ${CASE} | **Generated:** ${TS}
**Truth Score:** ${SCORE}% (${COMPUTABLE}/${TOTAL} COMPUTABLE) | **Verdict:** ${VERDICT}

> *COMMANDMENT XIII: THOU SHALT COMPUTE BEFORE CLAIMING*
> If it cannot be run → MYTHOLOGY. If it can → EVIDENCE.

---

## Claim Audit Table

| Claim | Test | Verdict | Hash | Timestamp |
|-------|------|---------|------|-----------|
$(grep -v "^case," "$LOG" | awk -F, '{
  sym="✅"
  if($7=="MYTHOLOGY") sym="❌"
  if($7=="PARTIAL")   sym="⚠️"
  printf "| %s | %s | %s %s | %s | %s |\n", $2,$3,sym,$7,$8,$9
}')

---

## Summary

- **COMPUTABLE** (${COMPUTABLE}): Claims backed by runnable, verifiable tests. Eligible for Library, capstone, DAO narrative, public proof.
- **PARTIAL** (${PARTIAL}): Tests pass but expected output not confirmed. Draft only — not for public artifacts.
- **MYTHOLOGY** (${MYTHOLOGY}): Tests fail. NOT eligible for any published artifact. Antibodies auto-created.

---

*Generated by \`sagco-compute-law-report\` — Brick 058b · SAGCO OS*
MD

echo "SAGCO_COMPUTE_LAW_REPORT_COMPLETE"
echo "REPORT : $REPORT"
echo "SCORE  : ${SCORE}%"
