#!/bin/sh
# SAGCO Public Showcase Builder — Brick 034
CASE="$1"
OUT="sagco_ish/public/site/index.html"
REPOS="sagco_ish/repo_map/logs/repo_registry.csv"
STATE="sagco_ish/shared_state/cases/${CASE}.json"
HALLU="sagco_ish/hallucheck/logs/hallucheck_eru.csv"
HEALTH="sagco_ish/health/logs/health_report.txt"
GOVLOG="sagco_ish/governance/logs/governance_register.csv"
ERULOG="sagco_ish/wafer/logs/wafer_eru.csv"
[ -z "$CASE" ] && echo "usage: sagco-public-build CASE" && exit 1
mkdir -p sagco_ish/public/site
TS=$(busybox date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

cat > "$OUT" <<HTML
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SAGCO OS — Proof Node</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body { font-family: system-ui, Arial, sans-serif; background:#0b0f14; color:#e8f0ff; padding:40px; line-height:1.5; }
h1,h2 { color:#7dd3fc; }
.card { background:#11161f; border:1px solid #334455; border-radius:12px; padding:18px; margin:14px 0; }
.ok { color:#4cff8f; font-weight:600; }
.bad { color:#ff6b6b; font-weight:600; }
code { background:#1a2230; padding:2px 6px; border-radius:4px; }
pre { background:#0a0e14; padding:16px; border-radius:8px; overflow:auto; font-size:0.85em; }
.meta { color:#64748b; font-size:0.8em; }
</style>
</head>
<body>
<h1>SAGCO OS — Proof Node</h1>
<p class="ok">&#x25cf; Runtime Status: ACTIVE</p>
<p>Case: <code>$CASE</code> &nbsp;|&nbsp; Built: <code>$TS</code></p>

<h2>Current State</h2>
<pre>$(cat "$STATE" 2>/dev/null || echo "STATE_NOT_FOUND")</pre>

<h2>Captured Repositories</h2>
HTML

tail -n +2 "$REPOS" 2>/dev/null | grep "^$CASE," | while IFS=, read c repo lang note status ts; do
  echo "<div class='card'><b>$repo</b><br><small>$lang</small><br>$note<br><code>$status @ $ts</code></div>" >> "$OUT"
done

cat >> "$OUT" <<HTML

<h2>Governance Evidence Chain</h2>
HTML

if [ -f "$GOVLOG" ]; then
  tail -n +2 "$GOVLOG" | grep "^$CASE," | while IFS=, read c label file hash status ts; do
    SHORT=$(echo "$hash" | cut -c1-20)
    echo "<div class='card'><b>$label</b><br><code>$file</code><br>SHA256: <code>${SHORT}...</code><br><span class='meta'>$status &nbsp; $ts</span></div>" >> "$OUT"
  done
else
  echo "<p class='meta'>NO_GOVERNANCE_LOG_YET</p>" >> "$OUT"
fi

cat >> "$OUT" <<HTML

<h2>ERU Variance Log</h2>
<pre>$(tail -n +2 "$ERULOG" 2>/dev/null | grep "^$CASE," | tail -10 || echo "NO_ERU_DATA")</pre>

<h2>Latest Self-Audit (Hallucheck)</h2>
<pre>$(tail -5 "$HALLU" 2>/dev/null || echo "No hallucheck data yet")</pre>

<h2>System Health</h2>
<pre>$(tail -30 "$HEALTH" 2>/dev/null || echo "No health report yet")</pre>

<h2>Agent Fleet</h2>
<pre>$(tail -n +1 sagco_ish/registry/logs/command_registry.csv 2>/dev/null | head -25)</pre>

<p style="margin-top:40px;opacity:0.6;font-size:0.9em;">
SAGCO OS &bull; Sovereign &bull; Self-Verifying &bull; No Vendor Lock-in<br>
Generated by <code>sagco-public-build</code>
</p>
</body>
</html>
HTML

echo "SAGCO_PUBLIC_SITE_BUILT"
echo "$OUT"
sagco_ish/shared_state/bin/sagco-state "$CASE" "PUBLIC_BUILD_NODE" "ACTIVE" "site_built_$TS" 2>/dev/null || true

# Auto-redact: always produce a public-safe version
REDACTED="sagco_ish/public/site/index_redacted.html"
if [ -f sagco_ish/redact/bin/sagco-redact ]; then
  sagco_ish/redact/bin/sagco-redact "$CASE" "$OUT" "$REDACTED" "auto_redact_public_build" 2>/dev/null || true
  echo "SAGCO_REDACT_OUTPUT: $REDACTED"
fi
