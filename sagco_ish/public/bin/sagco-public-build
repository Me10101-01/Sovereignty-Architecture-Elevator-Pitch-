#!/bin/sh
# usage: sagco-public-build CASE
CASE="$1"
OUT="sagco_ish/public/site/index.html"
REPOS="sagco_ish/repo_map/logs/repo_registry.csv"
GOVLOG="sagco_ish/governance/logs/governance_register.csv"
ERULOG="sagco_ish/wafer/logs/wafer_eru.csv"
STATE="sagco_ish/shared_state/cases/${CASE}.json"
[ -z "$CASE" ] && echo "usage: sagco-public-build CASE" && exit 1
mkdir -p sagco_ish/public/site
TS=$(busybox date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

cat > "$OUT" <<HTML
<!doctype html>
<html>
<head>
<title>SAGCO OS Proof Node</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
body{font-family:Arial,sans-serif;background:#0b0f14;color:#e8f0ff;padding:30px;max-width:900px;margin:0 auto}
h1{color:#7dd3fc}h2{color:#a5b4fc;border-bottom:1px solid #334;padding-bottom:6px}
.card{border:1px solid #334;padding:14px;margin:10px 0;border-radius:10px;background:#111827}
.ok{color:#4cff8f}.bad{color:#ff6b6b}.warn{color:#fbbf24}
code{color:#7dd3fc;font-size:0.9em}
pre{background:#0d1117;padding:12px;border-radius:8px;overflow-x:auto;font-size:0.85em}
.meta{color:#64748b;font-size:0.8em}
</style>
</head>
<body>
<h1>SAGCO OS — Sovereignty Architecture Proof Node</h1>
<p class="ok">&#x25cf; RUNTIME ACTIVE</p>
<p class="meta">Case: <code>$CASE</code> &nbsp;|&nbsp; Built: <code>$TS</code></p>

<h2>Current Mesh State</h2>
<pre>$(cat "$STATE" 2>/dev/null || echo "STATE_NOT_FOUND")</pre>

<h2>Repository Map</h2>
HTML

if [ -f "$REPOS" ]; then
  tail -n +2 "$REPOS" | grep "^$CASE," | while IFS=, read c repo lang note status ts; do
    echo "<div class='card'><b>$repo</b> &nbsp;<code>$lang</code><br>$note<br><span class='meta'>$status &nbsp; $ts</span></div>" >> "$OUT"
  done
else
  echo "<p class='warn'>NO_REPO_MAP_YET</p>" >> "$OUT"
fi

cat >> "$OUT" <<HTML

<h2>Governance Evidence Chain</h2>
HTML

if [ -f "$GOVLOG" ]; then
  tail -n +2 "$GOVLOG" | grep "^$CASE," | while IFS=, read c label file hash status ts; do
    SHORT_HASH=$(echo "$hash" | cut -c1-16)
    echo "<div class='card'><b>$label</b><br><code>$file</code><br>SHA256: <code>${SHORT_HASH}...</code><br><span class='meta'>$status &nbsp; $ts</span></div>" >> "$OUT"
  done
else
  echo "<p class='warn'>NO_GOVERNANCE_LOG_YET</p>" >> "$OUT"
fi

cat >> "$OUT" <<HTML

<h2>ERU Variance Log</h2>
<pre>
HTML

tail -n +2 "$ERULOG" 2>/dev/null | grep "^$CASE," | tail -10 >> "$OUT"

cat >> "$OUT" <<HTML
</pre>

<h2>Agent Fleet</h2>
<pre>$(tail -n +1 sagco_ish/registry/logs/command_registry.csv 2>/dev/null | head -20)</pre>

<hr>
<p class="meta">Generated by SAGCO sagco-public-build &nbsp;|&nbsp; Sovereign, offline-first, zero cloud dependency</p>
</body>
</html>
HTML

echo "SAGCO_PUBLIC_SITE_BUILT"
echo "OUTPUT=$OUT"
sagco_ish/shared_state/bin/sagco-state "$CASE" "PUBLIC_BUILD_NODE" "ACTIVE" "site_built_$TS" 2>/dev/null || true
