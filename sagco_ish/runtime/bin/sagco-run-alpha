#!/bin/sh
# SAGCO Runtime Alpha — Master Orchestrator
# usage: sagco-run-alpha CASE [gmail]
CASE="$1"
DO_GMAIL="${2:-no}"
[ -z "$CASE" ] && echo "usage: sagco-run-alpha CASE [gmail]" && exit 1
LOG="sagco_ish/runtime/logs/runtime_alpha.csv"
mkdir -p sagco_ish/runtime/logs
[ ! -f "$LOG" ] && echo "case,agent,status,timestamp" > "$LOG"
TS() { busybox date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE; }
run_agent() {
  NAME="$1"
  CMD="$2"
  echo "RUNNING: $NAME"
  echo "$CASE,$NAME,START,$(TS)" >> "$LOG"
  sh -c "$CMD" >/tmp/sagco_${NAME}.out 2>/tmp/sagco_${NAME}.err
  STATUS=$?
  echo "$CASE,$NAME,EXIT_$STATUS,$(TS)" >> "$LOG"
  [ $STATUS -ne 0 ] && echo "WARNING: $NAME exited with code $STATUS"
}
echo "===== SAGCO RUNTIME ALPHA START: $CASE ====="
# Wing K: hardware fleet status at the start of every cycle
run_agent boot   "sagco_ish/boot/bin/sagco-boot $CASE"
run_agent fleet        "sagco_ish/nodes/bin/sagco-nodes --fleet"
run_agent factory-scan "sagco_ish/factory/bin/sagco-factory-scan SAGCO_FACTORY_001 $CASE"
run_agent state-read     "sagco_ish/shared_state/bin/sagco-state-read $CASE"
run_agent portfolio-fuzz "sagco_ish/portfolio/bin/sagco-portfolio-fuzz $CASE sagco_ish"
run_agent bill-fuzz      "sagco_ish/fuzz/bin/sagco-bill-fuzz $CASE sagco_ish"
if [ "$DO_GMAIL" = "gmail" ]; then
  run_agent gmail-scan "sagco_ish/gmail/bin/sagco-gmail-scan"
fi
run_agent analyze   "sagco_ish/analysis/bin/sagco-analyze $CASE"
run_agent dashboard "sagco_ish/dashboard/bin/sagco-dashboard $CASE"
run_agent portfolio-generate "sagco_ish/agents/portfolio/bin/sagco-portfolio-generate $CASE"
REPORT="sagco_ish/portfolio/case-studies/${CASE}_SAGCO_Portfolio_Case_Study.md"
TRUTH="sagco_ish/hallucheck/source_truth/sagco_os_truth.txt"
if [ -f "$TRUTH" ] && [ -f "$REPORT" ]; then
  run_agent hallucheck "sagco_ish/hallucheck/bin/sagco-hallucheck $CASE $TRUTH $REPORT runtime_alpha_self_audit"
fi
# Translation Engine: verify all registered symbol translations still compute
run_agent translate-verify "sagco_ish/lineage/bin/sagco-translate --list"
run_agent eru-benchmark  "sagco_ish/eru/bin/sagco-eru-benchmark $CASE"
run_agent bibliography   "sagco_ish/bibliography/bin/sagco-bibliography $CASE"
run_agent evo            "sagco_ish/evo/bin/sagco-evo $CASE"
# Wing G: score workflow fragmentation before governance runs
run_agent collapse-score "sagco_ish/collapse/bin/sagco-collapse-score $CASE 3"
# Commandment XIII: verify core claims compute before cycle ends
run_agent compute-law-constitution "sagco_ish/compute_law/bin/sagco-compute-law $CASE constitution_upheld sagco_ish/constitution/bin/sagco-commandments CONSTITUTION_EXEMPLARY"
run_agent compute-law-report "sagco_ish/compute_law/bin/sagco-compute-law-report $CASE"
# Sonify the cycle — feed the runtime log itself into MIDI
if [ -f "$LOG" ]; then
  run_agent midi "sagco_ish/midi/bin/sagco-midi $LOG ${CASE}_alpha $CASE"
fi
# Wing H: close every cycle with coordinate snapshot of core bricks
# Wing I: log any friction the cycle revealed as a potential contradiction
run_agent alchemy-report "sagco_ish/alchemy/bin/sagco-alchemy --report $CASE"
# Wing H: close every cycle with coordinate snapshot of core bricks
run_agent coords-evo       "sagco_ish/coords/bin/sagco-coords sagco-evo $CASE"
run_agent coords-translate "sagco_ish/coords/bin/sagco-coords sagco-translate $CASE"
run_agent coords-compute   "sagco_ish/coords/bin/sagco-coords sagco-compute-law $CASE"
# Wing K: close every cycle with a live status snapshot — what is ALIVE
run_agent status "sagco_ish/status/bin/sagco-status $CASE"
sagco_ish/shared_state/bin/sagco-state "$CASE" "RUNTIME_ALPHA_NODE" "ACTIVE" "alpha_cycle_complete_$(TS)" 2>/dev/null || true
echo "===== SAGCO RUNTIME ALPHA COMPLETE ====="
tail -25 "$LOG"
