#!/bin/sh
# usage: sagco-public-verify CASE
CASE="$1"
PKG="sagco_ish/deploy/pages_package"
OUT="sagco_ish/deploy/logs/verify_eru.csv"
[ -z "$CASE" ] && echo "usage: sagco-public-verify CASE" && exit 1
mkdir -p sagco_ish/deploy/logs
[ ! -f "$OUT" ] && echo "case,check,expected,actual,status,timestamp" > "$OUT"
TS=$(busybox date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo NO_DATE)

PASS=0; FAIL=0

check() {
  LABEL="$1"; EXPECTED="$2"; ACTUAL="$3"
  if [ "$ACTUAL" = "$EXPECTED" ]; then
    STATUS="GREEN"
    PASS=$((PASS+1))
  else
    STATUS="VERIFY_ALERT"
    FAIL=$((FAIL+1))
  fi
  echo "$CASE,$LABEL,$EXPECTED,$ACTUAL,$STATUS,$TS" >> "$OUT"
  echo "$STATUS  $LABEL  expected=[$EXPECTED]  actual=[$ACTUAL]"
}

echo "=== SAGCO PUBLIC VERIFY: $CASE ==="

# File existence checks
check "index_html_exists" \
  "YES" \
  "$([ -f "$PKG/index.html" ] && echo YES || echo NO)"

check "readme_exists" \
  "YES" \
  "$([ -f "$PKG/README.md" ] && echo YES || echo NO)"

# Section presence in index.html
INDEX="$PKG/index.html"
check "section_current_state" \
  "YES" \
  "$(grep -q "Current State" "$INDEX" 2>/dev/null && echo YES || echo NO)"

check "section_captured_repos" \
  "YES" \
  "$(grep -q "Captured Repositories" "$INDEX" 2>/dev/null && echo YES || echo NO)"

check "section_health" \
  "YES" \
  "$(grep -q "Health\|health" "$INDEX" 2>/dev/null && echo YES || echo NO)"

# Repo count (expected >= 1)
REPO_COUNT=$(grep -c "REPO_SIGNAL_CAPTURED" "$INDEX" 2>/dev/null | tr -d ' ')
check "repo_count_nonzero" \
  "YES" \
  "$([ "${REPO_COUNT:-0}" -gt 0 ] 2>/dev/null && echo YES || echo NO)"

# State block present
check "state_json_present" \
  "YES" \
  "$(grep -q "$CASE" "$INDEX" 2>/dev/null && echo YES || echo NO)"

echo ""
echo "PASS=$PASS  FAIL=$FAIL"
OVERALL="GREEN"
[ "$FAIL" -gt 0 ] && OVERALL="VERIFY_ALERT"
echo "OVERALL=$OVERALL"
echo "SAGCO_PUBLIC_VERIFY_COMPLETE"

sagco_ish/shared_state/bin/sagco-state "$CASE" "VERIFY_NODE" "$OVERALL" "verify_pass_${PASS}_fail_${FAIL}" 2>/dev/null || true
