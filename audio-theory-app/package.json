{
  "name": "audio-theory-app",
  "version": "1.0.0",
  "description": "Circle of Fifths, Circle of Fourths, and 88-Key Piano Frequencies — interactive Web Audio API app",
  "type": "module",
  "scripts": {
    "start":    "npx serve . --no-clipboard --listen 3000",
    "test":     "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "data":     "node src/main.js"
  },
  "devDependencies": {
    "jest":                    "^29.7.0",
    "@jest/globals":           "^29.7.0",
    "serve":                   "^14.2.3"
  },
  "jest": {
    "transform": {},
    "extensionsToTreatAsEsm": [".js"],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    }
  }
}
