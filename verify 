import math

# 1. THE CONVERSION (Minutes -> Decimal Degrees)
def minutes_to_decimal(minutes):
    return minutes / 60.0

# 2. THE GEOMETRY (Get Vector on Unit Circle)
def get_vector(decimal_degree):
    # Convert to radians for Python math functions
    rad = math.radians(decimal_degree)
    return {
        "x": math.cos(rad),
        "y": math.sin(rad)
    }

# 3. THE SYNAPSE GENERATOR (Dynamic Weighting)
def calculate_synapse(node_a, node_b):
    # A. Calculate the Angular Difference (The "Spread")
    angle_a = minutes_to_decimal(node_a['minute'])
    angle_b = minutes_to_decimal(node_b['minute'])
    delta_theta = abs(angle_b - angle_a)
    
    # B. Calculate "Travel" (Distance between tips of vectors)
    # Using Law of Cosines on Unit Circle: c^2 = a^2 + b^2 - 2ab cos(C)
    # Since radius is 1: Distance = sqrt(2 - 2cos(delta_theta))
    rad_delta = math.radians(delta_theta)
    travel_distance = math.sqrt(2 - 2 * math.cos(rad_delta))
    
    # C. Dynamic Weight Formula
    # The weight is determined by the TARGET algorithm's physics.
    # If Node B is "Gravity" (ALG-003), weight = Gravity Formula applied to distance.
    if node_b['type'] == "Gravity":
        # F = G / r^2
        weight = 1.0 / (travel_distance ** 2) if travel_distance > 0 else 0
    elif node_b['type'] == "Spring":
        # F = kx
        weight = 0.5 * (travel_distance ** 2)
    else:
        # Default Pipefitter: Weight is inversely proportional to the "Travel"
        # Closer algorithms (smaller angle difference) have stronger connections.
        weight = 1.0 / travel_distance if travel_distance > 0 else 1.0
        
    return {
        "from": node_a['id'],
        "to": node_b['id'],
        "travel_distance": travel_distance,
        "spread_degrees": delta_theta,
        "weight": weight
    }

