import math
import numpy as np

def trig_lookup(theta):
    rad = math.radians(theta)
    sin = math.sin(rad)
    cos = math.cos(rad)
    tan = math.tan(rad) if cos != 0 else float('inf')
    cot = 1 / tan if tan != 0 else float('inf')
    sec = 1 / cos if cos != 0 else float('inf')
    csc = 1 / sin if sin != 0 else float('inf')
    return [sin, cos, tan, cot, sec, csc]

