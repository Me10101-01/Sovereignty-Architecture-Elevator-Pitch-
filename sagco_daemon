#!/usr/bin/env bash
# sagco_daemon v0.3 — human-in-the-loop by default
#
# Usage:
#   ./sagco_daemon          # HITL mode (default) — waits for your approval
#   ./sagco_daemon --auto   # autonomous mode — runs pipeline without prompting
#   ./sagco_daemon --help   # show this message
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

case "${1:-}" in
  --help|-h)
    echo ""
    echo "  sagco_daemon v0.3"
    echo ""
    echo "  ./sagco_daemon          human-in-the-loop (default)"
    echo "                          daemon notifies you, you approve each action"
    echo ""
    echo "  ./sagco_daemon --auto   autonomous mode"
    echo "                          pipeline runs without prompting"
    echo "                          use only for non-destructive CI environments"
    echo ""
    exit 0
    ;;
  --auto)
    exec python3 sagco_daemon_core.py
    ;;
  *)
    exec python3 sagco_daemon_hitl.py "$@"
    ;;
esac
