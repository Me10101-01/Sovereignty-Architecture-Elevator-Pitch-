#!/bin/sh
# SAGCO-0073: FLAME_COMPILER
#
# Pipeline:
#   FLAME token (from flame_tokens.txt)
#   → generate fn {token}_rust() in Rust module
#   → register TYPE=FLAME in knowledge_compiler/dictionary
#   → register alias in knowledge_compiler/thesaurus
#   → register source in knowledge_compiler/bibliography
#   → register rust_call in knowledge_compiler/rust_calls/registry.txt
#   → emit SAGCO-0073+ IDs for each compiled token
#
# Usage:
#   ./bin/sagco-flame-compiler compile
#   ./bin/sagco-flame-compiler emit   <TOKEN>
#   ./bin/sagco-flame-compiler status

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOKENS="$REPO_ROOT/sagco_flame_linguistics/tokens/flame_tokens.txt"
POLY="$REPO_ROOT/sagco_flame_linguistics/polyglot"
KC="$REPO_ROOT/sagco_knowledge_compiler"
DICT="$KC/dictionary/brick_types.txt"
THES="$KC/thesaurus/brick_aliases.txt"
BIB="$KC/bibliography/source_index.txt"
RC="$KC/rust_calls/registry.txt"
OUT_RS="$REPO_ROOT/sagco_flame_linguistics/compiled/flame_module.rs"
OUT_MANIFEST="$REPO_ROOT/sagco_flame_linguistics/compiled/sagco_manifest.txt"

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"

mkdir -p "$REPO_ROOT/sagco_flame_linguistics/compiled"

log()    { printf "%s\n" "$1"; }
header() { log ""; log "=== $1 ==="; }

# ── REGISTER in knowledge compiler ────────────────────────────────────────────

register_type() {
  if ! grep -q "^FLAME=" "$DICT" 2>/dev/null; then
    printf "FLAME=FlameLang token — word-frequency-derived language primitive|LINGUISTICS|flame_compile|sagco_core\n" >> "$DICT"
    log "  DICT: +FLAME type registered"
  fi
}

register_alias() {
  TOKEN_LOWER="$1"
  WORD="$2"
  if ! grep -q "^$TOKEN_LOWER=" "$THES" 2>/dev/null; then
    printf "%s=FLAME\n" "$TOKEN_LOWER" >> "$THES"
  fi
  if ! grep -q "^$WORD=FLAME" "$THES" 2>/dev/null; then
    printf "%s=FLAME\n" "$WORD" >> "$THES"
  fi
}

register_bib() {
  if ! grep -q "^WAFER_CELLS=" "$BIB" 2>/dev/null; then
    printf "WAFER_CELLS=Word frequency wafer cells computed from sagco_custom_agent ZFold session|wafer_fuzz|ZFold|true\n" >> "$BIB"
    printf "FLAME_LINGUISTICS=SAGCO-FLAME-LINGUISTICS-FLEET computed output|sagco_flame_linguistics|Pi+ZFold|true\n" >> "$BIB"
    log "  BIB: +WAFER_CELLS +FLAME_LINGUISTICS sources registered"
  fi
}

register_rust_call() {
  FN="$1"
  TYPE="$2"
  WEIGHT="$3"
  if ! grep -q "^$FN=" "$RC" 2>/dev/null; then
    printf "%s=%s|sagco-flame|weight:%s auto-compiled by FLAME_COMPILER|COMPUTED\n" "$FN" "$TYPE" "$WEIGHT" >> "$RC"
  fi
}

# ── EMIT: write one Rust fn block ─────────────────────────────────────────────

emit_rust_fn() {
  TOKEN="$1"
  WORD="$2"
  RUST_CALL="$3"
  WEIGHT="$4"
  SAGCO_ID="$5"
  SAFE="$(echo "$TOKEN" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')"

  printf "/// %s  WORD=%-20s WEIGHT=%s  %s\n" "$TOKEN" "$WORD" "$WEIGHT" "$SAGCO_ID"
  printf "pub fn %s() {\n" "$SAFE"
  printf "    println!(\"TOKEN=%s WORD=%s WEIGHT=%s\");\n" "$TOKEN" "$WORD" "$WEIGHT"
  printf "}\n\n"
}

# ── COMPILE: process all tokens ───────────────────────────────────────────────

cmd_compile() {
  if [ ! -f "$TOKENS" ]; then
    log "ERROR: $TOKENS not found. Run sagco_flame_linguistics pipeline first."
    exit 1
  fi

  log "SAGCO-0073 FLAME_COMPILER"
  log "STAMP=$STAMP"
  log "INPUT=$TOKENS"
  log ""

  # Register once in knowledge compiler
  register_type
  register_bib

  # Rust module header
  printf "// SAGCO FLAME MODULE — auto-generated by bin/sagco-flame-compiler\n" > "$OUT_RS"
  printf "// STAMP=%s\n" "$STAMP" >> "$OUT_RS"
  printf "// SOURCE: sagco_flame_linguistics/tokens/flame_tokens.txt\n\n" >> "$OUT_RS"
  printf "#![allow(dead_code)]\n\n" >> "$OUT_RS"

  # Manifest header
  printf "# SAGCO FLAME MANIFEST\nSTAMP=%s\n\n" "$STAMP" > "$OUT_MANIFEST"

  COUNTER=72   # starts at SAGCO-0073
  TOTAL=0

  while IFS= read -r line; do
    # Parse: TOKEN=FLAME_X | WORD=x | RUST_CALL=fn | WEIGHT=N
    TOKEN="$(echo "$line" | sed 's/TOKEN=//;s/ |.*//')"
    WORD="$(echo "$line"  | sed 's/.*WORD=//;s/ |.*//')"
    RUST="$(echo "$line"  | sed 's/.*RUST_CALL=//;s/ |.*//')"
    WEIGHT="$(echo "$line" | sed 's/.*WEIGHT=//')"

    COUNTER=$((COUNTER + 1))
    SAGCO_ID="$(printf 'SAGCO-%04d' $COUNTER)"
    SAFE="$(echo "$TOKEN" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')"
    FN="${SAFE}()"

    # Emit Rust fn
    emit_rust_fn "$TOKEN" "$WORD" "$RUST" "$WEIGHT" "$SAGCO_ID" >> "$OUT_RS"

    # Register in knowledge compiler
    register_alias "$SAFE" "$WORD"
    register_rust_call "$FN" "FLAME" "$WEIGHT"

    # Manifest entry
    printf "BRICK_ID=%s\nTYPE=FLAME\nTOKEN=%s\nWORD=%s\nWEIGHT=%s\nRUST_CALL=%s\nANCESTOR=wafer_fuzz/cells/wafer_cells.txt\nDESCENDANTS=rust_calls.rs,cpp_calls.cpp,bluescript.bs,unity_headless.txt,epic_headless.txt,dna/language_strand.txt\nDEPLOY_STATUS=COMPUTED\n---\n" \
      "$SAGCO_ID" "$TOKEN" "$WORD" "$WEIGHT" "$FN" >> "$OUT_MANIFEST"

    log "  $SAGCO_ID  $TOKEN  weight=$WEIGHT  → $FN"
    TOTAL=$((TOTAL + 1))
  done < "$TOKENS"

  # Module entry point
  printf "pub fn compile_all() {\n" >> "$OUT_RS"
  while IFS= read -r line; do
    TOKEN="$(echo "$line" | sed 's/TOKEN=//;s/ |.*//')"
    SAFE="$(echo "$TOKEN" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')"
    printf "    %s();\n" "$SAFE" >> "$OUT_RS"
  done < "$TOKENS"
  printf "}\n" >> "$OUT_RS"

  log ""
  log "TOTAL_COMPILED=$TOTAL"
  log "RUST_MODULE=$OUT_RS"
  log "MANIFEST=$OUT_MANIFEST"
  log "STATUS=SAGCO_FLAME_COMPILER_PASS"
}

# ── STATUS ────────────────────────────────────────────────────────────────────

cmd_status() {
  header "SAGCO-0073 FLAME_COMPILER STATUS"
  log "TOKENS=$(wc -l < "$TOKENS" 2>/dev/null || echo 0)"
  log "COMPILED=$(ls "$REPO_ROOT/sagco_flame_linguistics/compiled/" 2>/dev/null | wc -l)"
  FLAME_IN_DICT="$(grep -c '^FLAME=' "$DICT" 2>/dev/null || echo 0)"
  FLAME_IN_RC="$(grep -c '|FLAME|' "$RC" 2>/dev/null || echo 0)"
  log "FLAME_DICT_TYPES=$FLAME_IN_DICT"
  log "FLAME_RUST_CALLS=$FLAME_IN_RC"
  if [ -f "$OUT_MANIFEST" ]; then
    log "MANIFEST_BRICKS=$(grep -c '^BRICK_ID=' "$OUT_MANIFEST")"
  fi
  log "STATUS=SAGCO_FLAME_COMPILER_READY"
}

# ── EMIT single token ─────────────────────────────────────────────────────────

cmd_emit() {
  PATTERN="${1:-}"
  if [ -z "$PATTERN" ]; then log "Usage: sagco-flame-compiler emit <TOKEN>"; exit 1; fi
  grep -i "$PATTERN" "$TOKENS" | head -5 | while IFS= read -r line; do
    TOKEN="$(echo "$line" | sed 's/TOKEN=//;s/ |.*//')"
    WORD="$(echo "$line"  | sed 's/.*WORD=//;s/ |.*//')"
    RUST="$(echo "$line"  | sed 's/.*RUST_CALL=//;s/ |.*//')"
    WEIGHT="$(echo "$line" | sed 's/.*WEIGHT=//')"
    SAFE="$(echo "$TOKEN" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_')"
    log "TOKEN=$TOKEN"
    log "WORD=$WORD"
    log "WEIGHT=$WEIGHT"
    log "RUST_FN: pub fn $SAFE() { println!(\"TOKEN=$TOKEN WORD=$WORD WEIGHT=$WEIGHT\"); }"
    log "LINEAGE: wafer_cells → flame_tokens → $SAFE → rust_module → deploy"
  done
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-status}"
shift 2>/dev/null || true

case "$CMD" in
  compile) cmd_compile ;;
  emit)    cmd_emit "$@" ;;
  status)  cmd_status   ;;
  *)       log "Usage: sagco-flame-compiler [compile|emit|status]"; exit 1 ;;
esac
