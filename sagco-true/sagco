def cmd_manifest() -> None:
    from sagco_true.language.vm.vm import run_file
    manifest_path = _ROOT / "MANIFEST.sagco"
    if not manifest_path.exists():
        print(f"[error] MANIFEST.sagco not found at {manifest_path}")
        return
    vm = run_file(str(manifest_path))
    owned = {k: v for k, v in vm.memory.items() if k.startswith("manifest.owns")}
    adapters = vm.memory.get("manifest.adapters", [])
    print(json.dumps({"owned": owned, "adapters": adapters, "world": vm.world}, indent=2))


def main() -> None:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        print(_banner())
        print(__doc__)
        return

    cmd = args[0]
    rest = args[1:]

    dispatch = {
        "version":    lambda: cmd_version(),
        "world":      lambda: cmd_world(),
        "boot":       lambda: cmd_boot(),
        "truth":      lambda: cmd_truth(),
        "antibodies": lambda: cmd_antibodies(),
        "manifest":   lambda: cmd_manifest(),
        "net":        lambda: cmd_net(rest[0] if rest else "", "--ping" in rest),
        "import":     lambda: cmd_import(rest[0] if rest else None),
        "lex":        lambda: cmd_lex(rest[0]) if rest else print("usage: sagco lex <file.sagco>"),
        "parse":      lambda: cmd_parse(rest[0]) if rest else print("usage: sagco parse <file.sagco>"),
        "compile":    lambda: cmd_compile(rest[0], rest[1] if len(rest) > 1 else None) if rest else print("usage: sagco compile <file.sagco>"),
        "run":        lambda: cmd_run(rest[0]) if rest else print("usage: sagco run <file.sagco>"),
        "replicate":  lambda: cmd_replicate(rest),
        "divide":     lambda: cmd_divide(rest),
        "palace":     lambda: cmd_palace(rest[0] if rest else "", rest[1:] if len(rest) > 1 else []),
        "khaos":      lambda: cmd_khaos(rest[0] if rest else "", rest[1:] if len(rest) > 1 else []),
        "concert":    lambda: cmd_concert(rest),
        "monitor":    lambda: cmd_monitor(rest),
        "serve":      lambda: cmd_serve(rest),
        "inspect":    lambda: cmd_inspect(rest[0]) if rest else print("usage: sagco inspect <file.sagcob>"),
        "heal":       lambda: cmd_heal(rest),
    }

    fn = dispatch.get(cmd)
    if fn:
        fn()
    else:
        print(f"[sagco] unknown command: {cmd!r}")
        print("run './sagco help' for usage")
        sys.exit(1)


if __name__ == "__main__":
    main()
