def cmd_version() -> None:
    print("SAGCO v0.1.0 — sagco-true runtime")
    from sagco_true.worlds.detector import detect
    p = detect()
    print(f"World:  {p.name}")
    print(f"Python: {p.python}")
    print(f"Git:    {'yes' if p.has_git else 'no'}")
    print(f"Home:   {p.home}")


def cmd_world() -> None:
    from sagco_true.worlds.detector import detect
    p = detect()
    print(json.dumps({
        "name": p.name, "shell": p.shell, "python": p.python,
        "has_git": p.has_git, "has_docker": p.has_docker,
        "home": p.home, "extra": p.extra
    }, indent=2))


def cmd_boot() -> None:
    from sagco_true.kernel.boot import boot, boot_report
    print("Booting SAGCO kernel...")
    vm = boot(str(_ROOT.parent))
    report = boot_report(vm)
    print(json.dumps(report, indent=2))


def cmd_truth() -> None:
    from sagco_true.wafers.runner import run_truth_test
    result = run_truth_test()
    print(json.dumps(result, indent=2))
    print(f"\n{'='*40}")
    print(f"Status: {result['status']}")
    print(f"Passed: {result['passed']}/{result['total']}")
    if result["failed_required"] == 0:
        print("All required wafers: PASS")
    else:
        print(f"FAILED required: {result['failed_required']}")


def cmd_antibodies() -> None:
    from sagco_true.antibodies.detector import run_all, report
    results = run_all()
    r = report(results)
    print(json.dumps(r, indent=2))
    print(f"\nStatus: {r['status']}  ({r['triggered']} triggered, {r['healed']} healed)")


def cmd_lex(path: str) -> None:
    from sagco_true.language.lexer.lexer import lex
    source = open(path).read()
    for tok in lex(source, path):
        print(tok)


def cmd_parse(path: str) -> None:
    from sagco_true.language.parser.parser import parse
    source = open(path).read()
    mod = parse(source, path)
    print(f"Module: {mod.filename}  ({len(mod.body)} statements)")
    for stmt in mod.body:
        print(f"  {type(stmt).__name__:25s} {getattr(stmt, 'name', '')}")


def cmd_compile(path: str, output: str | None = None) -> None:
    from sagco_true.language.bytecode.compiler import compile_source
    source = open(path).read()
    bc = compile_source(source, path)
    out_path = output or path.replace(".sagco", ".sagcob")
    bc.save(out_path)
    print(bc.dump())
    print(f"\nBytecode written → {out_path}")


def cmd_run(path: str) -> None:
    from sagco_true.language.vm.vm import run_file
    vm = run_file(path)
    report = vm.truth_report()
    print(json.dumps(report, indent=2))
    print(f"\nWorld:   {vm.world}")
    print(f"Memory:  {len(vm.memory)} keys")
    print(f"Signals: {len(vm.bus)}")
    print(f"PIDs:    {len(vm.pid_table)}")


def cmd_net(sub: str = "", do_ping: bool = False) -> None:
    from sagco_true.worlds.net.net import discover, sync_to_wafers
    wn = discover(ping=(do_ping or sub == "ping"))
    if sub == "sync":
        wafer_dir = _ROOT / "wafers"
        out = sync_to_wafers(wn, wafer_dir)
        print(f"Synced → {out}")
        print(wn.to_yaml())
    elif sub == "json":
        print(json.dumps(wn.to_dict(), indent=2))
    else:
        print(wn.to_yaml())
        if wn.reachability:
            print("\nReachability:")
            for r in wn.reachability:
                icon = "✓" if r.reachable else "✗"
                lat = f"{r.latency_ms}ms" if r.latency_ms else ""
                print(f"  {icon} {r.name:12s}  {r.ip:18s}  {lat}")


def cmd_import(path: str | None = None) -> None:
    from sagco_true.wafers.importer import import_all, merge_with_runner
    wafers = import_all(path)
    report = merge_with_runner(wafers)
    print(json.dumps(report, indent=2))
    print(f"\nImported: {report['total']} wafers")
    print(f"Status:   {report['status']}")


def cmd_palace(sub: str = "", args: list[str] = []) -> None:
    from sagco_true.worlds.palace import scan, diff_nodes, print_status, PalaceIndex

    flags = _parse_flags(args)
    organism_root = flags.get("root") or str(_ROOT.parent)
    palace_file   = _ROOT.parent / "palace.json"

    if sub in ("", "status"):
        print("  Scanning organism...")
        idx = scan(organism_root, verbose=True)
        print_status(idx)
        idx.save(palace_file)
        print(f"  Index saved → {palace_file}")

    elif sub == "scan":
        idx = scan(organism_root, verbose=True)
        print_status(idx)
        idx.save(palace_file)
        print(f"  Index saved → {palace_file}")

    elif sub == "locate":
        query = args[0] if args and not args[0].startswith("--") else flags.get("name", "")
        if not query:
            print("[error] sagco palace locate <name>")
            return
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        results = idx.locate(query)
        if not results:
            print(f"  Not found: {query!r}")
        else:
            for e in results:
                print(f"  {e.kind:12s}  {e.node:12s}  {e.path}")

    elif sub == "diff":
        nodes = [a for a in args if not a.startswith("--")]
        if len(nodes) < 2:
            print("[error] sagco palace diff <node-a> <node-b>")
            print("  Known nodes: local, wd-black, docker, zfold, pi")
            return
        node_a, node_b = nodes[0], nodes[1]
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        deltas = diff_nodes(idx, node_a, node_b)
        if not deltas:
            print(f"  No differences between {node_a} and {node_b}")
            return
        only_a   = [d for d in deltas if d.status == "only-in-a"]
        only_b   = [d for d in deltas if d.status == "only-in-b"]
        differs  = [d for d in deltas if d.status == "checksum-differs"]
        print(f"\n  Palace diff: {node_a} ↔ {node_b}")
        print(f"  Only in {node_a}  : {len(only_a)}")
        print(f"  Only in {node_b}  : {len(only_b)}")
        print(f"  Checksum differs  : {len(differs)}")
        for d in only_a[:10]:
            print(f"    > {d.kind:10s}  {d.name}")
        for d in only_b[:10]:
            print(f"    < {d.kind:10s}  {d.name}")
        for d in differs[:10]:
            print(f"    ~ {d.kind:10s}  {d.name}")

    elif sub == "json":
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        idx._rebuild_lookups()
        print(json.dumps(idx.to_dict(), indent=2))

    elif sub == "register":
        idx = scan(organism_root, verbose=True)
        idx.save(palace_file)
        print(f"  Node registered → {palace_file}")

    else:
        print(f"[palace] unknown subcommand: {sub!r}")
        print("  sagco palace [scan|status|locate <name>|diff <a> <b>|json|register]")


def _parse_flags(args: list[str]) -> dict:
    """Minimal flag parser for --key value and --bool-flag forms."""
    flags: dict = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            key = a[2:].replace("-", "_")
            if i + 1 < len(args) and not args[i + 1].startswith("--"):
                flags[key] = args[i + 1]
                i += 2
            else:
                flags[key] = True
                i += 1
        else:
            i += 1
    return flags


def cmd_replicate(args: list[str]) -> None:
    from sagco_true.replicator.replicator import replicate_cli

    flags = _parse_flags(args)

    target_name = flags.get("target")
    if not target_name:
        print("[error] --target required. Choose: usb, pi, phone, pxe, local")
        print("  Examples:")
        print("    sagco replicate --target pi    --ip 192.168.1.42")
        print("    sagco replicate --target usb   --mount /Volumes/SAGCO")
        print("    sagco replicate --target phone --via termux")
        print("    sagco replicate --target pxe   --ip 192.168.1.98")
        return

    port_raw = flags.get("port")
    port = int(port_raw) if port_raw and str(port_raw).isdigit() else None

    source = flags.get("source") or str(_ROOT.parent)

    session = replicate_cli(
        target_name=target_name,
        source_root=source,
        ip=flags.get("ip"),
        mount=flags.get("mount"),
        device=flags.get("device"),
        via=flags.get("via", "ssh"),
        host=flags.get("host"),
        user=flags.get("user"),
        port=port,
        ssh_key=flags.get("ssh_key"),
        pxe_root=flags.get("pxe_root"),
        tftp_root=flags.get("tftp_root"),
        iface=flags.get("iface", "eth0"),
        mode=flags.get("mode", "smart"),
        dry_run=bool(flags.get("dry_run", False)),
        verify_after=not bool(flags.get("no_verify", False)),
        print_summary=True,
    )

    if session.result and not session.result.success:
        sys.exit(1)


def cmd_divide(args: list[str]) -> None:
    from sagco_true.replicator.cell_division import divide

    flags = _parse_flags(args)

    new_cell = flags.get("new_cell")
    if not new_cell:
        print("[error] --new-cell <name> required")
        print("  Examples:")
        print("    sagco divide --new-cell 'HP-Node-01' --target-type pi --ip 192.168.1.42")
        print("    sagco divide --new-cell 'ZFold-Node' --target-type phone")
        return

    target_type  = flags.get("target_type", "local")
    ip           = flags.get("ip")
    out_dir      = flags.get("out") or flags.get("output")
    custom_raw   = flags.get("boards", "")
    custom_boards = [b.strip() for b in custom_raw.split(",") if b.strip()] if custom_raw else []

    source_root = flags.get("source") or str(_ROOT.parent)

    print(f"\nSAGCO Cell Division")
    print(f"  New cell    : {new_cell}")
    print(f"  Target type : {target_type}")
    if ip:
        print(f"  Target IP   : {ip}")
    if out_dir:
        print(f"  Output dir  : {out_dir}")

    identity = divide(
        source_root=source_root,
        new_cell_name=new_cell,
        target_type=target_type,
        target_ip=ip,
        custom_boards=custom_boards or None,
        output_dir=out_dir,
    )

    print(f"\n  Cell ID     : {identity.cell_id}")
    print(f"  Generation  : {identity.generation}")
    print(f"  Parent cell : {identity.parent_cell}")
    if out_dir:
        print(f"\n  Files written to: {out_dir}")
        print(f"    cell_identity.sagco")
        print(f"    DIVISION_MANIFEST.json")
        print(f"    cell_boot_wafer.sagco")
    print(f"\n  STATUS: CELL_DIVIDED")


def cmd_serve(args: list[str]) -> None:
    from sagco_true.worlds.serve import serve
    flags = _parse_flags(args)
    port_raw = flags.get("port", "8080")
    port = int(port_raw) if str(port_raw).isdigit() else 8080
    root = flags.get("root") or str(_ROOT.parent)
    readonly = not bool(flags.get("rw", False))
    serve(organism_root=root, port=port, readonly=readonly)


def cmd_manifest() -> None:
    from sagco_true.language.vm.vm import run_file
    manifest_path = _ROOT / "MANIFEST.sagco"
    if not manifest_path.exists():
        print(f"[error] MANIFEST.sagco not found at {manifest_path}")
        return
    vm = run_file(str(manifest_path))
    owned = {k: v for k, v in vm.memory.items() if k.startswith("manifest.owns")}
    adapters = vm.memory.get("manifest.adapters", [])
    print(json.dumps({"owned": owned, "adapters": adapters, "world": vm.world}, indent=2))


def main() -> None:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        print(_banner())
        print(__doc__)
        return

    cmd = args[0]
    rest = args[1:]

    dispatch = {
        "version":    lambda: cmd_version(),
        "world":      lambda: cmd_world(),
        "boot":       lambda: cmd_boot(),
        "truth":      lambda: cmd_truth(),
        "antibodies": lambda: cmd_antibodies(),
        "manifest":   lambda: cmd_manifest(),
        "net":        lambda: cmd_net(rest[0] if rest else "", "--ping" in rest),
        "import":     lambda: cmd_import(rest[0] if rest else None),
        "lex":        lambda: cmd_lex(rest[0]) if rest else print("usage: sagco lex <file.sagco>"),
        "parse":      lambda: cmd_parse(rest[0]) if rest else print("usage: sagco parse <file.sagco>"),
        "compile":    lambda: cmd_compile(rest[0], rest[1] if len(rest) > 1 else None) if rest else print("usage: sagco compile <file.sagco>"),
        "run":        lambda: cmd_run(rest[0]) if rest else print("usage: sagco run <file.sagco>"),
        "replicate":  lambda: cmd_replicate(rest),
        "divide":     lambda: cmd_divide(rest),
        "palace":     lambda: cmd_palace(rest[0] if rest else "", rest[1:] if len(rest) > 1 else []),
        "serve":      lambda: cmd_serve(rest),
    }

    fn = dispatch.get(cmd)
    if fn:
        fn()
    else:
        print(f"[sagco] unknown command: {cmd!r}")
        print("run './sagco help' for usage")
        sys.exit(1)


if __name__ == "__main__":
    main()
