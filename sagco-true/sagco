#!/usr/bin/env python3
"""
SAGCO Universal Launcher
Detects the world, boots the kernel, routes the command.
This file is the single entry point for everything.

Usage:
  ./sagco run <file.sagco>
  ./sagco boot
  ./sagco truth
  ./sagco antibodies
  ./sagco world
  ./sagco lex <file.sagco>
  ./sagco parse <file.sagco>
  ./sagco compile <file.sagco>
  ./sagco wafer <name>
  ./sagco manifest
  ./sagco version

  # Replication
  ./sagco replicate --target usb    --mount /Volumes/SAGCO
  ./sagco replicate --target pi     --ip 192.168.1.42
  ./sagco replicate --target phone  --via termux --ip 192.168.1.89
  ./sagco replicate --target phone  --via adb
  ./sagco replicate --target pxe    --ip 192.168.1.98
  ./sagco replicate --target local  --mount /tmp/sagco-clone
  ./sagco replicate --target pi     --ip 192.168.1.42 --mode verify
  ./sagco replicate --target usb    --mount /mnt/usb   --dry-run

  # Cell division
  ./sagco divide --new-cell "HP-Node-01" --target-type pi --ip 192.168.1.42
  ./sagco divide --new-cell "ZFold-Node" --target-type phone --out /tmp/cells
"""

import json
import os
import sys
from pathlib import Path

# make sagco_true importable
_ROOT = Path(__file__).parent
sys.path.insert(0, str(_ROOT.parent))

try:
    import sagco_true
    _SAGCO_TRUE_AVAILABLE = True
except ImportError:
    _SAGCO_TRUE_AVAILABLE = False


