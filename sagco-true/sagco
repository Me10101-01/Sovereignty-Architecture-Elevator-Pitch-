def cmd_palace(sub: str = "", args: list[str] = []) -> None:
    from sagco_true.worlds.palace import scan, diff_nodes, print_status, PalaceIndex

    flags = _parse_flags(args)
    organism_root = flags.get("root") or str(_ROOT.parent)
    palace_file   = _ROOT.parent / "palace.json"

    if sub in ("", "status"):
        print("  Scanning organism...")
        idx = scan(organism_root, verbose=True)
        print_status(idx)
        idx.save(palace_file)
        print(f"  Index saved → {palace_file}")

    elif sub == "scan":
        idx = scan(organism_root, verbose=True)
        print_status(idx)
        idx.save(palace_file)
        print(f"  Index saved → {palace_file}")

    elif sub == "locate":
        query = args[0] if args and not args[0].startswith("--") else flags.get("name", "")
        if not query:
            print("[error] sagco palace locate <name>")
            return
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        results = idx.locate(query)
        if not results:
            print(f"  Not found: {query!r}")
        else:
            for e in results:
                print(f"  {e.kind:12s}  {e.node:12s}  {e.path}")

    elif sub == "diff":
        nodes = [a for a in args if not a.startswith("--")]
        if len(nodes) < 2:
            print("[error] sagco palace diff <node-a> <node-b>")
            print("  Known nodes: local, wd-black, docker, zfold, pi")
            return
        node_a, node_b = nodes[0], nodes[1]
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        deltas = diff_nodes(idx, node_a, node_b)
        if not deltas:
            print(f"  No differences between {node_a} and {node_b}")
            return
        only_a   = [d for d in deltas if d.status == "only-in-a"]
        only_b   = [d for d in deltas if d.status == "only-in-b"]
        differs  = [d for d in deltas if d.status == "checksum-differs"]
        print(f"\n  Palace diff: {node_a} ↔ {node_b}")
        print(f"  Only in {node_a}  : {len(only_a)}")
        print(f"  Only in {node_b}  : {len(only_b)}")
        print(f"  Checksum differs  : {len(differs)}")
        for d in only_a[:10]:
            print(f"    > {d.kind:10s}  {d.name}")
        for d in only_b[:10]:
            print(f"    < {d.kind:10s}  {d.name}")
        for d in differs[:10]:
            print(f"    ~ {d.kind:10s}  {d.name}")

    elif sub == "json":
        if palace_file.exists():
            idx = PalaceIndex.load(palace_file)
        else:
            idx = scan(organism_root)
        idx._rebuild_lookups()
        print(json.dumps(idx.to_dict(), indent=2))

    elif sub == "register":
        idx = scan(organism_root, verbose=True)
        idx.save(palace_file)
        print(f"  Node registered → {palace_file}")

    else:
        print(f"[palace] unknown subcommand: {sub!r}")
        print("  sagco palace [scan|status|locate <name>|diff <a> <b>|json|register]")


def _parse_flags(args: list[str]) -> dict:
    """Minimal flag parser for --key value and --bool-flag forms."""
    flags: dict = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            key = a[2:].replace("-", "_")
            if i + 1 < len(args) and not args[i + 1].startswith("--"):
                flags[key] = args[i + 1]
                i += 2
            else:
                flags[key] = True
                i += 1
        else:
            i += 1
    return flags


def cmd_replicate(args: list[str]) -> None:
    from sagco_true.replicator.replicator import replicate_cli

    flags = _parse_flags(args)

    target_name = flags.get("target")
    if not target_name:
        print("[error] --target required. Choose: usb, pi, phone, pxe, local")
        print("  Examples:")
        print("    sagco replicate --target pi    --ip 192.168.1.42")
        print("    sagco replicate --target usb   --mount /Volumes/SAGCO")
        print("    sagco replicate --target phone --via termux")
        print("    sagco replicate --target pxe   --ip 192.168.1.98")
        return

    port_raw = flags.get("port")
    port = int(port_raw) if port_raw and str(port_raw).isdigit() else None

    source = flags.get("source") or str(_ROOT.parent)

    session = replicate_cli(
        target_name=target_name,
        source_root=source,
        ip=flags.get("ip"),
        mount=flags.get("mount"),
        device=flags.get("device"),
        via=flags.get("via", "ssh"),
        host=flags.get("host"),
        user=flags.get("user"),
        port=port,
        ssh_key=flags.get("ssh_key"),
        pxe_root=flags.get("pxe_root"),
        tftp_root=flags.get("tftp_root"),
        iface=flags.get("iface", "eth0"),
        mode=flags.get("mode", "smart"),
        dry_run=bool(flags.get("dry_run", False)),
        verify_after=not bool(flags.get("no_verify", False)),
        print_summary=True,
    )

    if session.result and not session.result.success:
        sys.exit(1)


def cmd_divide(args: list[str]) -> None:
    from sagco_true.replicator.cell_division import divide

    flags = _parse_flags(args)

    new_cell = flags.get("new_cell")
    if not new_cell:
        print("[error] --new-cell <name> required")
        print("  Examples:")
        print("    sagco divide --new-cell 'HP-Node-01' --target-type pi --ip 192.168.1.42")
        print("    sagco divide --new-cell 'ZFold-Node' --target-type phone")
        return

    target_type  = flags.get("target_type", "local")
    ip           = flags.get("ip")
    out_dir      = flags.get("out") or flags.get("output")
    custom_raw   = flags.get("boards", "")
    custom_boards = [b.strip() for b in custom_raw.split(",") if b.strip()] if custom_raw else []

    source_root = flags.get("source") or str(_ROOT.parent)

    print(f"\nSAGCO Cell Division")
    print(f"  New cell    : {new_cell}")
    print(f"  Target type : {target_type}")
    if ip:
        print(f"  Target IP   : {ip}")
    if out_dir:
        print(f"  Output dir  : {out_dir}")

    identity = divide(
        source_root=source_root,
        new_cell_name=new_cell,
        target_type=target_type,
        target_ip=ip,
        custom_boards=custom_boards or None,
        output_dir=out_dir,
    )

    print(f"\n  Cell ID     : {identity.cell_id}")
    print(f"  Generation  : {identity.generation}")
    print(f"  Parent cell : {identity.parent_cell}")
    if out_dir:
        print(f"\n  Files written to: {out_dir}")
        print(f"    cell_identity.sagco")
        print(f"    DIVISION_MANIFEST.json")
        print(f"    cell_boot_wafer.sagco")
    print(f"\n  STATUS: CELL_DIVIDED")


def cmd_concert(args: list[str] = []) -> None:
    from sagco_true.worlds.concert import Concert
    flags = _parse_flags(args)

    root     = flags.get("root") or str(_ROOT.parent)
    title    = flags.get("title")
    intent   = flags.get("intent")
    stream   = "stream" in args or bool(flags.get("stream", False))
    count_r  = flags.get("count", "1")
    interval_r = flags.get("interval", "2")
    count    = int(count_r) if str(count_r).isdigit() else 1
    interval = float(interval_r)
    nosave   = bool(flags.get("nosave", False))

    c = Concert(organism_root=root)

    if stream or count > 1:
        print(f"\n  SAGCO CONCERT — streaming {count if count else '∞'} ticks"
              f" @ {interval}s interval")
        print(f"  Ctrl-C to stop\n")
        try:
            for i, result in enumerate(c.stream(interval=interval, count=count or None,
                                                 verbose=True)):
                if count and i + 1 >= count:
                    break
        except KeyboardInterrupt:
            print("\n  Concert stopped.")
    else:
        print(f"\n  SAGCO CONCERT — single run")
        result = c.run(title=title, intent=intent, save=not nosave)
        c._print_result(result)
        if not nosave and result.saved_to:
            print(f"\n  FlameIR → {result.saved_to}")
            print(f"  Bytecode hints:")
            for line in result.ir.to_sagco_bytecode_hints()[:12]:
                print(f"    {line}")


def cmd_monitor(args: list[str] = []) -> None:
