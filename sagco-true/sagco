def cmd_inspect(path: str) -> None:
    """Inspect memory keys from a .sagcob bytecode file."""
    from sagco_true.language.bytecode.opcodes import Bytecode
    from sagco_true.language.vm.vm import SAGCOVirtualMachine
    from collections import defaultdict

    bc = Bytecode.load(path)
    vm = SAGCOVirtualMachine()
    vm.run(bc)

    # Group by prefix
    groups: dict[str, dict] = defaultdict(dict)
    for k, v in sorted(vm.memory.items()):
        prefix = k.split(".")[0] if "." in k else "_root"
        groups[prefix][k] = v

    report = vm.truth_report()
    print(f"\n  ══════════════════════════════════════════════════════════")
    print(f"  SAGCO INSPECT — {path}")
    print(f"  Status: {report.get('status', 'UNKNOWN')}  |  "
          f"{len(vm.memory)} keys  |  {len(bc.instructions)} instructions")
    print(f"  ══════════════════════════════════════════════════════════")

    for prefix, keys in sorted(groups.items()):
        print(f"\n  [{prefix}]  ({len(keys)} key{'s' if len(keys) != 1 else ''})")
        for k, v in sorted(keys.items()):
            display = str(v)
            if isinstance(v, str):
                display = v[:64] + "..." if len(v) > 64 else v
            print(f"    {k:<48} {display!r}")

    print(f"\n  Ticks  : {len(vm._ticks)}")
    print(f"  Signals: {len(vm.bus)}  ({set(s.name for s in vm.bus)})")
    print(f"  ══════════════════════════════════════════════════════════")


