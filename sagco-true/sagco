    mon = KHAOSMonitor()
    print(f"\n  KHAOS Process Monitor  (interval={interval}s)")
    print(f"  Ctrl-C to stop\n")

    try:
        for i, snap in enumerate(mon.stream(interval=interval, count=count)):
            if json_out:
                import json
                print(json.dumps(snap.to_dict(), indent=2))
            else:
                mon.print_snapshot(snap)
            if count and i + 1 >= count:
                break
    except KeyboardInterrupt:
        print("\n  Monitor stopped.")


