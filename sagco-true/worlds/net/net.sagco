# SAGCO Net World Map
# This file is generated by `sagco net sync` and kept as the authoritative record.
# Source of truth for the three-universe problem.

identity sagco-net {
  name: "SAGCO Network World Map"
  version: "0.1.0"
  type: "topology-record"
  generated: "2026-06-01"
}

# ── Layer 1: House LAN — the real physical network ────────────────────────
remember net.lan.lyra   "192.168.1.98"
remember net.lan.zfold  "192.168.1.89"
remember net.lan.router "192.168.1.254"
remember net.lan.pi5    "192.168.1.?"
remember net.lan.hp     "192.168.1.?"

# ── Layer 2: WSL2 virtual network ─────────────────────────────────────────
remember net.virtual.wsl    "172.24.32.1"
remember net.virtual.docker "172.24.33.13"

# ── The daemon ────────────────────────────────────────────────────────────
remember net.daemon.total_nodes 33902
remember net.daemon.total_edges 15577
remember net.daemon.file_count  42354
remember net.daemon.status      "SAGCO_TOPOLOGY_PASS"
remember net.daemon.root        "E:\\SAGCO-WORLD\\"

# ── The three universes ───────────────────────────────────────────────────
remember net.worlds.count 3
remember net.worlds.lan     "192.168.1.x — physical LAN"
remember net.worlds.wsl     "172.24.32.x — WSL2 virtual bridge"
remember net.worlds.docker  "172.24.33.x — Docker Desktop Linux"

# ── Why things keep breaking ─────────────────────────────────────────────
remember net.crossing_note "SAGCO keeps crossing universes. sagco net tells you where you are."
remember net.fix_lan_to_wsl   "WSL2 mirrored networking — .wslconfig networkingMode=mirrored"
remember net.fix_wsl_to_docker "localhost — same host process"
remember net.fix_lan_to_docker "docker network --driver bridge --subnet 192.168.1.x"

# Wafers
wafer lyra_ip_known {
  expected: "192.168.1.98"
  actual: "192.168.1.98"
  match: required
}

wafer zfold_ip_known {
  expected: "192.168.1.89"
  actual: "192.168.1.89"
  match: required
}

wafer daemon_running {
  expected: "SAGCO_TOPOLOGY_PASS"
  actual: "SAGCO_TOPOLOGY_PASS"
  match: required
}

wafer worlds_mapped {
  expected: yes
  actual: yes
  match: required
}

emit net_topology_loaded {
  worlds: 3
  daemon: "RUNNING"
  nodes: 33902
}
