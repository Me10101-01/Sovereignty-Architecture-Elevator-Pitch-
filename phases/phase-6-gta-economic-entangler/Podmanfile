# Podmanfile for rootless container deployment
# Compatible with Podman for Phase 6 GTA Economic Entangler

FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY config/ ./config/
COPY src/ ./src/
COPY tests/ ./tests/

# Set environment
ENV PYTHONPATH=/app/src:$PYTHONPATH

# Non-root user for rootless podman
RUN useradd -m -u 1000 strategickhaos && \
    chown -R strategickhaos:strategickhaos /app

USER strategickhaos

# Expose any necessary ports (if future phases need it)
EXPOSE 8090

CMD ["python", "src/sandbox_evolver.py", "--iterations", "100"]
